{
  "schemaVersion": 1,
  "id": "ymvilc",
  "version": "${version}",
  "name": "YM Veil Iris Lights Compat",
  "description": "Renders Veil point and area lights on top of the active Iris shaderpack, with an optional fallback pass when shaderpacks are disabled.",
  "authors": ["xcruell", "YesMenn!"],
  "license": "YesMenn Custom License 1.0",
  "icon": "icon.png",

  "environment": "client",

  "entrypoints": {
    "client": [
      "com.yesmenn.vilc.YMVilcFabric"
    ],
    "modmenu": [
      "com.yesmenn.vilc.YMVilcModMenu"
    ]
  },

  "mixins": [
    "ymvilc.mixins.iris.json",
    "ymvilc.mixins.veil.json",
    "ymvilc.mixins.betterf3.json",
    "ymvilc.mixins.fabric.json"
  ],

  "depends": {
    "fabricloader": ">=0.14.0",
    "fabric-api": "*",
    "minecraft": "1.21.1",
    "iris": ">=1.8.14-beta.1",
    "veil": ">=4.5.2",
    "sodium": ">=0.8.12-beta.1+mc1.21.1",
    "ymducttape": ">=0.1.1"
  },

  "suggests": {
    "modmenu": "*",
    "betterf3": "*"
  }
}
