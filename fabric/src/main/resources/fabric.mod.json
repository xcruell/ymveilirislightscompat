{
  "schemaVersion": 1,
  "id": "veil_iris_lights",
  "version": "${version}",
  "name": "Veil Iris Lights",
  "description": "Renders Veil point and area lights on top of the active Iris shaderpack, with an optional fallback pass when shaderpacks are disabled.",
  "authors": ["xcruell", "YesMenn!"],
  "license": "MIT",
  "icon": "icon.png",

  "environment": "client",

  "entrypoints": {
    "client": [
      "com.yesmenn.veilirislights.VeilIrisLightsFabric"
    ],
    "modmenu": [
      "com.yesmenn.veilirislights.VeilIrisLightsModMenu"
    ]
  },

  "mixins": [
    "veil_iris_lights.mixins.iris.json",
    "veil_iris_lights.mixins.veil.json",
    "veil_iris_lights.mixins.betterf3.json",
    "veil_iris_lights.mixins.fabric.json"
  ],

  "depends": {
    "fabricloader": ">=0.14.0",
    "fabric-api": "*",
    "minecraft": "~1.21.1",
    "iris": ">=1.8.14-beta.1",
    "veil": ">=4.5.2",
    "sodium": ">=0.8.12-beta.1+mc1.21.1"
  },

  "suggests": {
    "modmenu": "*",
    "betterf3": "*"
  }
}
